{
  "appId": "id.ai.trydesk.android",
  "appName": "TryDesk",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "app",
    "hostname": "app.trydesk.ai.id"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SystemBars": { "style": "DARK" }
  }
}
